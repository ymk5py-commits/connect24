# URL publica HTTPS donde corre connect24 (sin barra final). Bitrix24 debe poder alcanzarla.
PUBLIC_URL=https://connect24.tudominio.com

# Secreto aleatorio de >= 32 caracteres (cifra tokens y firma los webhooks). Generar con: openssl rand -hex 32
APP_SECRET=

# Credenciales de la aplicacion local (Bitrix24 > Recursos para desarrolladores > Otros > Aplicacion local)
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Portales autorizados a instalar la app (separados por coma). Muy recomendado.
BITRIX_ALLOWED_DOMAINS=vitriahome.bitrix24.es

# Opcionales
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/connect24.db
CONNECTOR_ID=connect24_whatsapp
CONNECTOR_NAME=WhatsApp (connect24)
LOG_LEVEL=info
